# .env.example - Copy this file to .env and fill in your own values
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/spotify_clone

# 🔐 ACCESS TOKEN (short-lived)
JWT_ACCESS_SECRET=your_super_secure_access_secret

# 🔁 REFRESH TOKEN
# NOTE: refresh tokens are opaque random values, HMAC'd via
# REFRESH_TOKEN_HMAC_SECRET below — not JWTs. This var is not read by any
# module, but is kept required in src/config/env.js as a placeholder for
# a possible future refresh-token-as-JWT mode. Set it to any random string.
JWT_REFRESH_SECRET=your_super_secure_refresh_secret

# 🔐 Required — HMAC key used to hash refresh tokens before storing them
# in Mongo (see src/utils/tokenStore.js). Server will not boot without
# this set. MUST be different from the two secrets above.
REFRESH_TOKEN_HMAC_SECRET=your_super_secure_refresh_hmac_secret

# ⏱ token expiry
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# 🖼 ImageKit Configuration
IMAGE_KIT_PUBLIC_KEY=your_imagekit_public_key
IMAGE_KIT_PRIVATE_KEY=your_imagekit_private_key
IMAGE_KIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# 💳 Stripe Configuration
CLIENT_URL=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_WEBHOOK_MODE=test
STRIPE_SUCCESS_URL=http://localhost:5173/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:5173/billing?checkout=cancel

STRIPE_AUTOMATIC_TAX=false

# 💎 PLAN CATALOG (Stripe -> Mongo sync, see src/config/plans.js)
# ---------------------------------------------------------------
# No plan/product IDs are stored here at all. Plan tiers, pricing, and
# features all live in the `Plan` collection in Mongo, kept in sync with
# Stripe via webhooks (product.created/updated, price.created/updated —
# see src/routes/webhook.routes.js and src/services/planSync.service.js).
# Creating or editing a Product in the Stripe Dashboard updates the app
# automatically, with no redeploy and no env var to add.
#
# First-time / fresh environment: run `node src/scripts/syncPlans.js`.
# It calls stripe.products.list() and backfills EVERY product Stripe
# returns — there's no product ID list to configure.

# 🔑 OPTIONAL ONE-TIME STRIPE DASHBOARD SETUP (per Product):
# - metadata.planKey        — internal key used in API payloads/URLs
#                              (default: slugified from the Product name)
# - metadata.dailyPlayLimit — number, or "unlimited"/"null" (default: unlimited)
# - metadata.canDownload    — "true"/"false" (default: false)
# - metadata.maxDownloads   — number, or "unlimited"/"null" (default: 0)
# - metadata.adFree         — "true"/"false" (default: false)
# See parseFeatureMetadata() / resolvePlanKey() in planSync.service.js.

# ==========================
# GOOGLE OAUTH
# ==========================

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

GOOGLE_CALLBACK_URL=https://sputter-squid-wispy.ngrok-free.dev/api/auth/google/callback

# ==========================
# EMAIL (forgot/reset password)
# ==========================
# Optional in development: if SMTP_HOST is left unset, the reset link is
# printed to the server console instead of emailed, so you can test the
# flow with zero email setup. Set these for real delivery (works with
# Gmail app passwords, Brevo, Mailtrap, SendGrid SMTP relay, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@yourapp.com

# ==========================
# ADMIN SEED
# ==========================
# Used by src/scripts/seedAdmin.js to create the first admin account.
ADMIN_SEED_EMAIL=admin@yourapp.com
ADMIN_SEED_PASSWORD=your_strong_admin_seed_password