# In development the frontend uses a Vite dev-server proxy to forward `/api`
# requests to the backend. Leave this blank for local dev (the app will use
# a same-origin `/api` path which Vite proxies), or set it to your production
# API base (including `/api`) when building for deployment.
VITE_API_BASE_URL=

# OAuth entrypoint must point directly at the backend public URL used for
# Google OAuth. This MUST match the redirect URI registered in Google Cloud
# Console exactly, and it should not be proxied through Vite because OAuth is
# a top-level browser navigation, not an AJAX call.
VITE_OAUTH_BASE_URL=

# NOTE: On ngrok free tier this value changes whenever the tunnel restarts.
# That means you must update both VITE_OAUTH_BASE_URL and the Google Cloud
# Console redirect URI together after the ngrok URL rotates.

# Development Vite proxy target.
VITE_DEV_API_TARGET=http://localhost:3000

# Runtime timing controls in milliseconds.
VITE_ACCESS_TOKEN_EXPIRES_MS=900000
VITE_ACCESS_TOKEN_REFRESH_LEAD_MS=120000
VITE_MINIMUM_REFRESH_DELAY_MS=30000
VITE_SEARCH_DEBOUNCE_MS=350
VITE_TRENDING_TIMEOUT_MS=5000
VITE_UNREAD_REFRESH_MS=30000
VITE_MAX_RECENT_SEARCHES=6

# Public creator link shown on the welcome page.
VITE_CREATOR_CV_URL=https://github.com/Saim-mayo
