# .env.test — dummy values ONLY, used exclusively by the Jest test suite.
# Safe to commit: none of these are real credentials. The test DB is an
# in-memory MongoDB instance spun up per test file (see tests/testDb.js),
# so MONGO_URI here is unused, and no real Stripe/Google/ImageKit/SMTP
# calls are ever made — those modules just need *some* value present at
# require-time (several throw on boot if their env vars are missing).

NODE_ENV=test
PORT=3000

MONGO_URI=mongodb://127.0.0.1:27017/spotify_clone_test

JWT_ACCESS_SECRET=test_access_secret_do_not_use_in_prod
JWT_REFRESH_SECRET=test_refresh_secret_do_not_use_in_prod
REFRESH_TOKEN_HMAC_SECRET=test_refresh_hmac_secret_do_not_use_in_prod
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

IMAGE_KIT_PUBLIC_KEY=test_public_key
IMAGE_KIT_PRIVATE_KEY=test_private_key
IMAGE_KIT_URL_ENDPOINT=https://ik.imagekit.io/test

CLIENT_URL=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_dummy_key_for_tests
STRIPE_WEBHOOK_SECRET=whsec_dummy
STRIPE_WEBHOOK_MODE=test
STRIPE_SUCCESS_URL=http://localhost:5173/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:5173/billing?checkout=cancel
STRIPE_AUTOMATIC_TAX=false

GOOGLE_CLIENT_ID=test_google_client_id
GOOGLE_CLIENT_SECRET=test_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Dummy values — required by src/config/env.js boot validation, only used
# by src/scripts/seedAdmin.js, which never runs during the test suite.
ADMIN_SEED_EMAIL=admin_test@example.com
ADMIN_SEED_PASSWORD=dummy_admin_seed_password_for_tests

# Left unset on purpose: no SMTP config means email.service.js falls back
# to logging the reset link instead of sending — exactly what we want in
# tests, on top of the explicit mock used in auth.test.js.
SMTP_HOST=
